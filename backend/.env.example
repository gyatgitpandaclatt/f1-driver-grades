# Copy this file to backend/.env and fill in your key. backend/.env is
# gitignored, so it's safe to put real secrets in it.

# Used by the Race Summary page (backend/app/race_summary/) to write the race
# narrative. Gemini is tried first and Cerebras is the fallback; set at least
# one. Both have free tiers.
#   Gemini:   https://aistudio.google.com/apikey
#   Cerebras: https://cloud.cerebras.ai
GEMINI_API_KEY=
CEREBRAS_API_KEY=
